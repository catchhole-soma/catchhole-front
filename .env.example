VITE_API_BASE_URL=http://localhost:8080
# Enabled by default. Set to false and rebuild to temporarily hide the relationship workspace.
VITE_RELATIONSHIP_WORKSPACE_ENABLED=true
# 오류 리포트(신규 회차 검수) 접수·재시도·재검수 진입점. 운영은 미설정(OFF). 로컬 검증 때만 true.
VITE_EPISODE_VALIDATION_INTAKE_ENABLED=true

# PG review only. Production is OFF by default; this does not enable real sales.
VITE_PAYMENT_REVIEW_ENABLED=false
# DEV preview only. Production /billing obtains its channel from the authorized backend API.
# Use a verified KG Inicis V2 TEST channel from the PortOne console, never a live channel.
# These are public SDK identifiers. Never put REST API secrets in VITE_* variables.
VITE_PORTONE_TEST_STORE_ID=
VITE_PORTONE_TEST_CHANNEL_KEY=
# Populate only after the public contact / registration is confirmed.
VITE_CUSTOMER_SERVICE_PHONE=
VITE_MAIL_ORDER_REGISTRATION=
